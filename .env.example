# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Firebase integration. The app automatically runs with local demo data
# when these values are not configured.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only settings for lead/contact API forwarding (optional)
LEAD_WEBHOOK_URL=

# Optional: dedicated server-side MapTiler key for address autocomplete/reverse geocoding.
# With MapTiler SPOTLY_MAP_STYLE_URL, Spotly can reuse its existing origin-bound
# public map key automatically. This is separate from verified road-routing prices.
# MapTiler uses a GeoJSON response schema (not Nominatim); the adapter is in lib/.
SPOTLY_MAPTILER_GEOCODING_KEY=
