# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Firebase integration. The app automatically runs with local demo data
# when these values are not configured.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only settings for lead/contact API forwarding (optional)
LEAD_WEBHOOK_URL=

# Spotly Ride V9: only configure licensed/operated services on the server.
# Must not use public Nominatim for interactive autocomplete.
SPOTLY_GEOCODING_URL=
SPOTLY_REVERSE_GEOCODING_URL=
# HTTPS OSRM-compatible routing service with production permission and quota
SPOTLY_ROUTING_URL=
# Unique, high-entropy secret >=32 characters. Do not use the payment password.
SPOTLY_RIDE_PIN_KEY=
# Trusted external scheduler authorizing /api/internal/ride-dispatch
CRON_SECRET=

# SpotlySend V9 controlled Zimbabwe rollout (server only)
# Must be unique from SPOTLY_RIDE_PIN_KEY, 32+ cryptographically random chars.
SPOTLY_SEND_PIN_KEY=
# Road routing, licensed forward/reverse address search, and an actual protected
# external scheduler are shared with Ride. See SPOTLY_ROUTING_URL,
# SPOTLY_GEOCODING_URL, SPOTLY_REVERSE_GEOCODING_URL and CRON_SECRET.

# Licensed OSM-derived vector tiles / MapLibre style JSON URL (browser-visible token).
# Example format ONLY: https://maps.yourprovider.example/styles/spotly/style.json?key=YOUR_PUBLIC_RESTRICTED_TOKEN
# Public demo tiles and tile.openstreetmap.org are not suitable for Spotly's live commercial service.
SPOTLY_MAP_STYLE_URL=
# SPOTLY_GEOCODING_URL and SPOTLY_REVERSE_GEOCODING_URL must be
# Nominatim-response-compatible, production-licensed HTTPS endpoints; append
# your server-side provider key in their query string, never NEXT_PUBLIC.
# Provide real externally hosted, signed 1-minute recurring calls for Ride/Send;
# configuration does not create the scheduler.
