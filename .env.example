# Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Firebase integration. The app automatically runs with local demo data
# when these values are not configured.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only settings for lead/contact API forwarding (optional)
LEAD_WEBHOOK_URL=

# Spotly Ride V9: only configure licensed/operated services on the server.
# Must not use public Nominatim for interactive autocomplete.
SPOTLY_GEOCODING_URL=
SPOTLY_REVERSE_GEOCODING_URL=
# HTTPS OSRM-compatible routing service with production permission and quota
SPOTLY_ROUTING_URL=
# Unique, high-entropy secret >=32 characters. Do not use the payment password.
SPOTLY_RIDE_PIN_KEY=
# Trusted external scheduler authorizing /api/internal/ride-dispatch
CRON_SECRET=
