# Optional: override the trusted HTTPS OSRM-compatible routing endpoint.
# Defaults to https://api.mapmap.ai when not set.
# SPOTLY_ROUTING_URL=https://api.mapmap.ai
# IMPORTANT: do NOT place SPOTLY_ROUTING_API_KEY here.
# Store it in Firebase/Google Secret Manager:
# firebase functions:secrets:set SPOTLY_ROUTING_API_KEY --project spotly-africa
# Vercel's provider key is NOT inherited by Firebase Functions.
