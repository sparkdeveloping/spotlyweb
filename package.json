{
  "name": "spotly-web-platform",
  "version": "7.0.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "predev": "node scripts/firebase-project-preflight.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/firebase-project-preflight.mjs && node --test tests/operations-override-framework.test.mjs tests/v9-assist-research-menu.test.mjs tests/maptiler-geocoding.test.mjs tests/ride-quote-preview-v9.test.mjs tests/mapmap-routing-v9.test.mjs tests/mobility-service-coverage.test.mjs tests/driver-v8-production.test.mjs tests/v9-cross-site-experience.test.mjs tests/ride-lab-distance-v9.test.mjs tests/v9-premium-ux.test.mjs tests/themenu-image-catalog-v9.test.mjs tests/admin-operations-v9.test.mjs tests/email-verification-v9.test.mjs tests/auth-session-stability-v9.test.mjs tests/nxt-auth-bootstrap.test.mjs tests/branding-kit.test.mjs tests/premium-experience-2026.test.mjs tests/spotly-curation-2026.test.mjs tests/book-live-artwork-release.test.mjs tests/business-photography.test.mjs tests/spotly-ordering.test.mjs tests/specific-catalogues.test.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "check:js": "node scripts/check-javascript.mjs",
    "firebase:preflight": "node scripts/firebase-project-preflight.mjs",
    "check": "npm run check:js && npm run firebase:preflight && npm run functions:check && npm run test:platform-foundation && npm run check:theme && npm run audit:launch && npm test && npm run lint && npm run build",
    "seed": "node scripts/seed-firestore.mjs",
    "firebase:emulators": "npx firebase-tools emulators:start",
    "firebase:deploy:indexes": "npx --yes firebase-tools@15.35.0 deploy --project spotly-africa --only firestore:indexes",
    "firebase:deploy:rules": "npx --yes firebase-tools@15.35.0 deploy --project spotly-africa --only firestore:rules,database,storage",
    "test": "node --test",
    "test:theme": "node --test tests/theme-integrity.test.mjs tests/contrast.test.mjs",
    "test:integrity": "node --test tests/theme-integrity.test.mjs tests/contrast.test.mjs tests/reservation-release.test.mjs",
    "check:theme": "node scripts/theme-safety.mjs",
    "test:rules": "npx --yes firebase-tools emulators:exec --project demo-spotly-rules --only auth,firestore,storage \"node --test tests/emulator/rules-emulator.mjs\"",
    "test:security": "node --test tests/security-commerce-integrity.test.mjs",
    "audit:locations": "node scripts/audit-business-locations.mjs",
    "audit:launch": "node scripts/launch-readiness-audit.mjs",
    "audit:v7-ui": "node scripts/audit-v7-ui.mjs",
    "contracts:generate": "node scripts/generate-contract-bindings.mjs",
    "contracts:check": "node --test tests/canonical-contracts-v1.test.mjs",
    "contracts:verify-snapshots": "node scripts/verify-contract-snapshots.mjs",
    "functions:check": "npm --prefix firebase/functions run check",
    "firebase:deploy:functions": "npx --yes firebase-tools@15.35.0 deploy --project spotly-africa --only functions:platform",
    "firebase:deploy:database-rules": "npx --yes firebase-tools@15.35.0 deploy --project spotly-africa --only database",
    "firebase:deploy:platform": "npx --yes firebase-tools@15.35.0 deploy --project spotly-africa --only functions:platform,firestore:rules,firestore:indexes,database,storage",
    "test:platform-foundation": "node --test tests/firebase-platform-foundation.test.mjs",
    "test:emulator:platform": "npx --yes firebase-tools@15.35.0 emulators:exec --project demo-spotly-platform --only auth,firestore,database,functions,storage \"node --test tests/emulator/platform-foundation-emulator.mjs\"",
    "firebase:emulators:platform": "npx --yes firebase-tools@15.35.0 emulators:start --project demo-spotly-platform --only auth,firestore,database,functions,storage",
    "countries:generate": "node scripts/generate-country-bindings.mjs",
    "countries:check": "node --test tests/country-engine-v1.test.mjs",
    "countries:verify-snapshots": "node scripts/verify-country-snapshots.mjs",
    "services:generate": "node scripts/generate-service-availability-bindings.mjs",
    "services:check": "node --test tests/service-availability-engine.test.mjs tests/service-availability-control-plane.test.mjs",
    "services:verify-snapshots": "node scripts/verify-service-availability-snapshots.mjs",
    "customer-web:check": "node --test tests/customer-web-runtime.test.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "firebase": "12.16.0",
    "firebase-admin": "14.2.0",
    "framer-motion": "12.42.2",
    "lottie-web": "5.12.2",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "paynow": "2.2.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  },
  "type": "module",
  "packageManager": "npm@11.16.0"
}
