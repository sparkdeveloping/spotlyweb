{
  "name": "spotly-web-platform",
  "version": "5.4.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:js": "node scripts/check-javascript.mjs",
    "check": "npm run check:js && npm run check:theme && npm test && npm run lint && npm run build",
    "seed": "node scripts/seed-firestore.mjs",
    "firebase:emulators": "npx firebase-tools emulators:start",
    "firebase:deploy:indexes": "npx firebase-tools deploy --only firestore:indexes",
    "firebase:deploy:rules": "npx firebase-tools deploy --only firestore:rules,storage",
    "test": "node --test",
    "test:theme": "node --test tests/theme-integrity.test.mjs tests/contrast.test.mjs",
    "test:integrity": "node --test tests/theme-integrity.test.mjs tests/contrast.test.mjs tests/reservation-release.test.mjs",
    "check:theme": "node scripts/theme-safety.mjs",
    "test:rules": "npx --yes firebase-tools emulators:exec --project demo-spotly-rules --only auth,firestore,storage \"node --test tests/emulator/rules-emulator.mjs\"",
    "test:security": "node --test tests/security-commerce-integrity.test.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "firebase": "12.16.0",
    "firebase-admin": "14.2.0",
    "framer-motion": "12.42.2",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "paynow": "2.2.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "4.15.9"
    }
  },
  "type": "module",
  "packageManager": "npm@11.16.0"
}
